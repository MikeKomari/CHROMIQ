# dependencies
/node_modules

# next.js build output
/.next/
/out/

# typescript build info
*.tsbuildinfo

# scratch bundle used when driving lib/server/capture.ts outside Next
/.capture-build/

# git bundles produced for hand-off; never part of the tree
*.bundle

# environment (never commit real keys)
.env
.env.*
!.env.example

# vercel project link
.vercel

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# os
.DS_Store

# local certificates
*.pem
# oh-my-claudecode operational state (project skills are the committable exception)
.omc/*
!.omc/skills/
