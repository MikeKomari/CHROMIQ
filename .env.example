# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit real credentials.
# The app runs without any of these; they are needed for accounts and cloud sync.

# Pooled Postgres connection used by the app at runtime.
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/DATABASE

# Direct (non-pooled) Postgres connection, used by `npm run migrate` only.
DIRECT_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Path to your database provider's CA certificate, if it requires one for TLS.
# Leave empty if your provider's certificate is publicly trusted.
PGSSLROOTCERT=

# Public origin of the site, with no trailing slash. Used for canonical URLs,
# Open Graph metadata, robots.txt, and sitemap.xml. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random secret for the account session layer. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string
