# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit real credentials.
# The app runs without any of these; they are needed for accounts and cloud sync.

# Pooled Postgres connection used by the app at runtime. PgBouncer's default
# port is 6432; 6543 is Supabase's, if that is where you are pointing.
DATABASE_URL=postgres://USER:PASSWORD@HOST:6432/DATABASE

# Direct (non-pooled) Postgres connection, used by `npm run migrate` only.
DIRECT_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Path to your database provider's CA certificate, if it requires one for TLS.
# Leave empty if your provider's certificate is publicly trusted.
#
# node-postgres does NOT read this variable by itself -- only libpq-based
# clients like psql do. For it to take effect through this app the CA has to
# reach the driver one of two ways: as `?sslrootcert=/path/to/ca.crt` inside
# the connection string above, which is what works locally, or passed in code
# as `ssl: { ca: ... }`. A file path is meaningless on a serverless host, so
# there the CA travels as the certificate text rather than a path.
PGSSLROOTCERT=

# Public origin of the site, with no trailing slash. Used for canonical URLs,
# Open Graph metadata, robots.txt, and sitemap.xml. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random secret for the account session layer. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Accounts and cloud sync: "on", "off", or unset to follow DATABASE_URL.
# Set this to "off" to run the workspace locally without accounts while keeping
# DATABASE_URL in place for `npm run migrate`. Every account, share and project
# route then answers 503 without opening a connection, and the account controls
# are hidden rather than shown and broken.
CHROMIQ_ACCOUNTS=
