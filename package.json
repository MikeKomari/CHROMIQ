{
  "name": "chromiq-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate -j sql -m migrations --envPath .env.local -d DIRECT_URL",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down 1",
    "migrate:create": "npm run migrate -- create"
  },
  "dependencies": {
    "@next/swc-wasm-nodejs": "^15.5.27",
    "@radix-ui/react-slot": "^1.2.3",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "motion": "^14.1.0",
    "next": "^15.1.6",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
